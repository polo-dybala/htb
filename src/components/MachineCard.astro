---
import Badge from './Badge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writeups'>;
}

const { entry } = Astro.props;
const { title, machine, os, difficulty, releaseDate, tags, description, image } = entry.data;

const formattedDate = new Date(releaseDate).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="card" href={`/htb/writeups/${entry.slug}`}>
  {image && (
    <div class="card__image">
      <img src={image} alt={`${machine} box art`} loading="lazy" />
    </div>
  )}
  <div class="card__body">
    <div class="card__badges">
      <Badge label={os} variant={os} />
      <Badge label={difficulty} variant={difficulty} />
    </div>
    <h3 class="card__title">{title}</h3>
    <p class="card__machine">{machine}</p>
    <p class="card__description">{description}</p>
    <div class="card__footer">
      <div class="card__tags">
        {tags.slice(0, 3).map((tag) => <span class="card__tag">{tag}</span>)}
      </div>
      <time class="card__date">{formattedDate}</time>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface, #16161f);
    border: 1px solid var(--color-border, #2a2a3a);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent, #4ade80);
  }

  .card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card__badges {
    display: flex;
    gap: 0.4rem;
  }

  .card__title {
    font-size: 1.05rem;
    margin: 0;
  }

  .card__machine {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted, #9ca3af);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card__description {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary, #c7c7d1);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
    font-size: 0.75rem;
  }

  .card__tags {
    display: flex;
    gap: 0.35rem;
  }

  .card__tag {
    background: var(--color-surface-alt, #1e1e2a);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    color: var(--color-text-muted, #9ca3af);
  }

  .card__date {
    color: var(--color-text-muted, #9ca3af);
  }
</style>
