---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>© {year} htb-writeups — build with Astro.</p>
    <p class="site-footer__note">À des fins éducatives uniquement.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border, #2a2a3a);
    margin-top: 4rem;
  }

  .site-footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-text-muted, #9ca3af);
  }

  .site-footer__note {
    opacity: 0.7;
  }
</style>
