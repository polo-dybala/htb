---
import { getCollection } from 'astro:content';
import MachineCard from '../../components/MachineCard.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const entries = (await getCollection('writeups')).sort(
  (a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime()
);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Writeups · htb-writeups</title>
  </head>
  <body>
    <Header />
    <main class="page">
      <div class="header">
        <h1>Writeups</h1>
        <p>{entries.length} machine{entries.length > 1 ? 's' : ''} found{entries.length > 1 ? 's' : ''}</p>
      </div>
      <div class="grid">
        {entries.map((entry) => <MachineCard entry={entry} />)}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .header {
    margin-bottom: 2rem;
  }

  .header h1 {
    font-size: 2rem;
    margin: 0 0 0.3rem;
  }

  .header p {
    color: var(--color-text-muted, #9ca3af);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
