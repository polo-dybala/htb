---
import { getCollection } from 'astro:content';
import MachineCard from '../components/MachineCard.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const entries = (await getCollection('writeups')).sort(
  (a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime()
);
const latest = entries.slice(0, 3);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Writeups et notes techniques de machines Hack The Box." />
    <title>htb-writeups</title>
  </head>
  <body>
    <Header />

    <section class="hero">
      <div class="hero__inner">
        <p class="hero__eyebrow">$ whoami</p>
        <h1 class="hero__title">Writeups Hack The Box</h1>
        <p class="hero__subtitle">
          Technical notes, methodologies, and detailed exploitation walkthroughs for each retired machine
        </p>
        <a class="hero__cta" href="/htb/writeups">See all the writeups →</a>
      </div>
    </section>

    <main class="page">
      <div class="section-header">
        <h2>Last writeups</h2>
        <a href="/htb/writeups">See all</a>
      </div>
      <div class="grid">
        {latest.map((entry) => <MachineCard entry={entry} />)}
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border, #2a2a3a);
    padding: 4.5rem 1.5rem;
    text-align: center;
    background:
      radial-gradient(circle at 50% 0%, rgba(74, 222, 128, 0.08), transparent 60%);
  }

  .hero__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero__eyebrow {
    font-family: 'JetBrains Mono', monospace;
    color: var(--color-accent, #4ade80);
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .hero__title {
    font-size: 2.75rem;
    margin: 0 0 1rem;
  }

  .hero__subtitle {
    color: var(--color-text-secondary, #c7c7d1);
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .hero__cta {
    display: inline-block;
    background: var(--color-accent, #4ade80);
    color: #0a0a0f;
    font-weight: 600;
    text-decoration: none;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 4rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .section-header a {
    font-size: 0.85rem;
    color: var(--color-text-muted, #9ca3af);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>
